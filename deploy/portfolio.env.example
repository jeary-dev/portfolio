# Copy to deploy/portfolio.env (git-ignored) and fill in:
#   cp deploy/portfolio.env.example deploy/portfolio.env
# After editing, run `make -C deploy deploy-local` to apply.

# Public URL: canonical links, Open Graph, sitemap and robots.txt.
# Baked in at build time, so changing it needs a rebuild (deploy-local does that).
NEXT_PUBLIC_SITE_URL=https://jeary.dev

# Optional. Fine-grained GitHub token with no permissions (public data only).
# Raises the API limit from 60 to 5,000 requests an hour and enables the GraphQL
# contribution calendar. Without it the site still stays well inside 60 an hour.
GITHUB_TOKEN=
